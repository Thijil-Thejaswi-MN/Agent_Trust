# ============================================================================
# AgentTrust Environment Configuration (.env.example)
# NOTE: This file contains placeholders only. Copy to .env.local and populate
# with your actual local secrets. NEVER commit .env.local to Git.
# ============================================================================

# PostgreSQL Configuration (Mapped to host port 5433 to preserve local WSL on 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agenttrust
POSTGRES_USER=agenttrust_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Database Connection URL (for Node.js pg client)
DATABASE_URL=postgresql://agenttrust_admin:your_secure_postgres_password_here@localhost:5433/agenttrust

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=agenttrust
MONGO_USER=agenttrust_mongo
MONGO_PASSWORD=your_secure_mongo_password_here

# MongoDB Connection URI (for Node.js mongodb driver)
MONGODB_URI=mongodb://agenttrust_mongo:your_secure_mongo_password_here@localhost:27017/agenttrust?authSource=admin

# Application Secrets
JWT_SECRET=your_super_secret_jwt_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
